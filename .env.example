# Copy this file to .env and fill in your values. .env is git-ignored.

# Required from Step 4 on: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which Claude model the agent uses.
# claude-haiku-5-5 is fast and cheap (good for a public demo); claude-opus-5-5 is the most capable.
CLAUDE_MODEL=claude-haiku-5-5

# Optional: a GitHub token raises API rate limits and enables code search.
GITHUB_TOKEN=

# Safety limits
MAX_AGENT_STEPS=10

# How hard Claude thinks per step: low | medium | high
EFFORT=medium

# Abuse / cost protection (per visitor per hour, and a daily cap for the whole server)
NEW_CHATS_PER_HOUR=10
MESSAGES_PER_HOUR=60
DAILY_BUDGET_USD=1.00
